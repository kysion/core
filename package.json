{
  "name": "@kysion/core",
  "version": "1.0.11",
  "description": "Kysion Admin 核心功能包，提供基础组件、布局、主题等核心功能",
  "main": "dist/lib/index.js",
  "module": "dist/es/index.js",
  "types": "dist/lib/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm build:lib && pnpm build:es",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:es": "tsc -p tsconfig.es.json",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "typescript",
    "kysion",
    "core",
    "api"
  ],
  "author": "SupenBysz",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify/json": "^2.2.350",
    "@iconify/react": "^6.0.0",
    "@iconify/types": "^2.0.0",
    "@kysion/types": "workspace:*",
    "@kysion/utils": "workspace:*",
    "@types/react-dom": "^19.1.6",
    "antd": "^5.26.1",
    "axios": "^1.10.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "i18next": "^25.2.1",
    "lodash": "^4.17.21",
    "react": "^19.1.0",
    "react-dom": "19.1.0",
    "react-highlight-words": "^0.21.0",
    "react-i18next": "^15.5.3",
    "react-router": "^7.6.2",
    "zustand": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "typescript": ">=5.8.3"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.18",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-highlight-words": "^0.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}