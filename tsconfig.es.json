{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "esnext",
        "outDir": "dist/es",
        "declaration": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@kysion/utils": ["../utils/src"],
            "@kysion/types": ["../types/src"]
        }
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist", "src/api/_pending"]
}
